---
/**
 * The interactive API reference — Qeet ID, and the canonical entry point.
 *
 * One product per page (see `referenceHref` in src/config/scalar.ts): with a
 * single Scalar `source` there is no Scalar document selector competing with
 * the Qeet product switcher, and every product has a real, shareable URL.
 * Qeet ID stays at `/reference` so the original route keeps working.
 *
 * All Scalar options live in src/config/scalar.ts, including the verified
 * settings that remove its platform chrome through supported configuration
 * rather than CSS, and the `customCss` theme bridge that needs no JavaScript.
 *
 * `renderMode="client"` matters: the default ("static") injects a complete
 * second `<!doctype html>` document inside <main>.
 */
import { ScalarComponent } from "@scalar/astro";
import ReferenceLayout from "../../layouts/ReferenceLayout.astro";
import { PRODUCTS } from "../../config/products";
import { scalarConfigFor } from "../../config/scalar";

const product = PRODUCTS[0];
---

<ReferenceLayout
  title={`${product.name} API Reference`}
  section={product.name}
  description={`Interactive reference for the ${product.name} API — ${product.description}`}
  activeProductId={product.id}
>
  <ScalarComponent renderMode="client" configuration={scalarConfigFor(product)} />
</ReferenceLayout>
