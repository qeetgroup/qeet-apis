---
import MarketingLayout from "../layouts/MarketingLayout.astro";
import Hero from "../components/marketing/Hero.astro";
import ProductSuite from "../components/marketing/ProductSuite.astro";
import PlatformOverview from "../components/marketing/PlatformOverview.astro";
import OpenStandards from "../components/marketing/Integrations.astro";
import DeveloperJourney from "../components/marketing/DeveloperJourney.astro";
import PlatformFoundations from "../components/marketing/PlatformMetrics.astro";
import DeveloperResources from "../components/marketing/DocsPreview.astro";
import CalloutCTA from "../components/marketing/CalloutCTA.astro";
import { LINKS } from "../data/catalog";
---

<MarketingLayout
  title="Qeet APIs - One developer platform for every Qeet product"
  description="Explore Qeet API references, integration guides, OpenAPI specifications, and client tooling. One developer platform for a growing product ecosystem."
>
  <Hero />
  <ProductSuite />
  <PlatformOverview />
  <OpenStandards />
  <DeveloperJourney />
  <PlatformFoundations />
  <DeveloperResources />
  <CalloutCTA
    title="Start building"
    highlight="with Qeet APIs."
    text="Explore the API reference, follow the quickstart, and start integrating in your local environment, all in one place."
    primary={{ href: LINKS.reference, label: "Open API Reference", icon: "arrow-right" }}
    secondary={{ href: LINKS.quickstart, label: "Read Quickstart", icon: "book" }}
  />
</MarketingLayout>

<script>
  // Dependency-free scroll choreography: reveal-on-view + count-up.
  (() => {
    const root = document.documentElement;
    const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const revealAll = () => root.classList.add("anim-fallback");

    if (reduce || !("IntersectionObserver" in window)) {
      revealAll();
      return;
    }

    try {
      // 1) Reveal elements as they scroll into view.
      const revealIO = new IntersectionObserver(
        (entries, obs) => {
          for (const e of entries) {
            if (!e.isIntersecting) continue;
            e.target.classList.add("is-in");
            obs.unobserve(e.target);
          }
        },
        { rootMargin: "0px 0px -8% 0px", threshold: 0.08 },
      );
      document.querySelectorAll("[data-reveal]").forEach((el) => revealIO.observe(el));

      // 2) Count-up numbers when their stat scrolls in.
      const easeOut = (t: number) => 1 - Math.pow(1 - t, 3);
      const countUp = (el: HTMLElement) => {
        const target = Number(el.dataset.count || "0");
        const suffix = el.dataset.suffix || "";
        const dur = 1300;
        const start = performance.now();
        const tick = (now: number) => {
          const p = Math.min((now - start) / dur, 1);
          el.textContent = Math.round(easeOut(p) * target) + suffix;
          if (p < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      };
      const countIO = new IntersectionObserver(
        (entries, obs) => {
          for (const e of entries) {
            if (!e.isIntersecting) continue;
            countUp(e.target as HTMLElement);
            obs.unobserve(e.target);
          }
        },
        { threshold: 0.6 },
      );
      document.querySelectorAll<HTMLElement>("[data-count]").forEach((el) => countIO.observe(el));
    } catch {
      revealAll();
    }
  })();
</script>
