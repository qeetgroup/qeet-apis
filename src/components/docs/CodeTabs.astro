---
import { Code } from "astro:components";
import Icon from "../shared/Icon.astro";

interface Tab {
  label: string;
  lang: string;
  code: string;
}
interface Props {
  tabs: Tab[];
}
const { tabs } = Astro.props;

/**
 * Tabs need stable, unique ids to wire `aria-controls` / `aria-labelledby`.
 * A module-scoped counter is deterministic within a build (unlike a random
 * suffix, which would churn the output on every run).
 */
let instance = 0;
const id = `codetabs-${(instance += 1)}`;
---

<div class="codetabs bezel not-prose">
  <div class="bezel-core overflow-hidden">
  <div
    class="codetabs__bar flex items-center gap-1 overflow-x-auto border-b border-rule bg-surface-2 px-2 py-2"
    role="tablist"
    aria-label="Code examples"
  >
    {
      tabs.map((t, i) => (
        <button
          type="button"
          class="codetabs__tab whitespace-nowrap rounded-full px-3 py-1.5 font-ui text-[0.85rem] font-semibold text-ink-subtle transition duration-500 ease-(--ease-spring) hover:text-ink"
          role="tab"
          id={`${id}-tab-${i}`}
          aria-selected={i === 0 ? "true" : "false"}
          aria-controls={`${id}-panel-${i}`}
          tabindex={i === 0 ? 0 : -1}
          data-tab={i}
        >
          {t.label}
        </button>
      ))
    }
    <button
      type="button"
      class="codetabs__copy ml-auto grid h-8 w-8 shrink-0 place-items-center rounded-full text-ink-faint transition duration-500 ease-(--ease-spring) hover:bg-surface-3 hover:text-ink"
      aria-label="Copy code"
    >
      <Icon name="copy" class="copy h-4 w-4" />
      <Icon name="check" class="check h-4 w-4" />
    </button>
  </div>
  {
    tabs.map((t, i) => (
      <div
        class="codetabs__panel"
        id={`${id}-panel-${i}`}
        data-panel={i}
        data-active={i === 0 ? "" : undefined}
        role="tabpanel"
        aria-labelledby={`${id}-tab-${i}`}
        tabindex="0"
      >
        <Code
          code={t.code}
          lang={t.lang as any}
          themes={{ light: "github-light", dark: "github-dark" }}
          defaultColor={false}
          wrap
        />
      </div>
    ))
  }
  </div>
</div>

<script>
  document.querySelectorAll(".codetabs").forEach((root) => {
    const tabs = root.querySelectorAll(".codetabs__tab");
    const panels = root.querySelectorAll(".codetabs__panel");
    const copy = root.querySelector(".codetabs__copy");

    const select = (tab: Element, moveFocus = false) => {
      const i = tab.getAttribute("data-tab");
      tabs.forEach((t) => {
        const active = t === tab;
        t.setAttribute("aria-selected", active ? "true" : "false");
        // Roving tabindex: only the selected tab is in the tab order, so Tab
        // moves past the tablist rather than through every language.
        t.setAttribute("tabindex", active ? "0" : "-1");
      });
      panels.forEach((p) => {
        if (p.getAttribute("data-panel") === i) p.setAttribute("data-active", "");
        else p.removeAttribute("data-active");
      });
      if (moveFocus) (tab as HTMLElement).focus();
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => select(tab));
      tab.addEventListener("keydown", (event) => {
        const key = (event as KeyboardEvent).key;
        const last = tabs.length - 1;
        let next = -1;
        if (key === "ArrowRight") next = index === last ? 0 : index + 1;
        else if (key === "ArrowLeft") next = index === 0 ? last : index - 1;
        else if (key === "Home") next = 0;
        else if (key === "End") next = last;
        if (next === -1) return;
        event.preventDefault();
        select(tabs[next], true);
      });
    });

    copy?.addEventListener("click", async () => {
      const active = root.querySelector<HTMLElement>(".codetabs__panel[data-active]");
      const text = active?.innerText ?? "";
      try {
        await navigator.clipboard.writeText(text.trim());
        copy.classList.add("is-copied");
        setTimeout(() => copy.classList.remove("is-copied"), 1500);
      } catch {}
    });
  });
</script>
