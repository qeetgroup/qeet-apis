---
import Icon from "../shared/Icon.astro";
import { LINKS } from "../../data/catalog";

const resources = [
  {
    title: "API Reference",
    text: "Explore endpoints, schemas, and generated code for each Qeet product.",
    icon: "braces",
    href: LINKS.reference,
    action: "Explore the APIs",
  },
  {
    title: "Quickstart",
    text: "Choose your environment and make your first authenticated request.",
    icon: "terminal",
    href: LINKS.quickstart,
    action: "Make a first request",
  },
  {
    title: "Authentication",
    text: "Understand API keys, bearer tokens, scopes, and identity flows.",
    icon: "key",
    href: LINKS.authentication,
    action: "Find your auth flow",
  },
  {
    title: "SDKs & Clients",
    text: "Find SDK source repositories, HTTP clients, and Postman collections.",
    icon: "package",
    href: LINKS.sdks,
    action: "Choose your tools",
  },
  {
    title: "Errors & Rate Limits",
    text: "Interpret response codes, handle failures, and make retries predictable.",
    icon: "alert",
    href: LINKS.errors,
    action: "Handle the edge cases",
  },
  {
    title: "Changelog",
    text: "Follow documented API additions and specification updates.",
    icon: "history",
    href: LINKS.changelog,
    action: "See what changed",
  },
] as const;
---

<section class="developer-resources" id="resources" aria-labelledby="resources-title">
  <div class="container container-wide">
    <header class="resources-heading" data-reveal>
      <h2 id="resources-title">Everything developers need,<br class="hidden md:block" /> within reach.</h2>
      <p>Start a new integration. Pick up where you left off. Find the answer that moves your work forward.</p>
    </header>
    <nav class="resource-grid" aria-label="Developer resources">
      {resources.map((resource) => (
        <a class="resource-link" href={resource.href}>
          <span class="resource-icon"><Icon name={resource.icon} class="h-6 w-6" /></span>
          <h3>{resource.title}</h3>
          <p>{resource.text}</p>
          <span class="resource-action">{resource.action}<Icon name="arrow-up-right" class="h-4 w-4" /></span>
        </a>
      ))}
    </nav>
    <button class="resource-search" type="button" data-search-trigger aria-haspopup="dialog"><Icon name="search" class="h-4 w-4" />Search the documentation<Icon name="arrow-right" class="h-4 w-4" /></button>
  </div>
</section>

<style>
  .developer-resources { padding-block: 5rem 3.5rem; background: var(--bg); scroll-margin-top: var(--header-h); }
  .resources-heading { max-width: 47rem; margin-inline: auto; text-align: center; }
  .resources-heading h2 { margin: 0; font-size: 2rem; line-height: 1.15; letter-spacing: 0; }
  .resources-heading p { max-width: 34rem; margin: 1rem auto 0; font-size: 1rem; line-height: 1.65; color: var(--ink-muted); text-wrap: pretty; }
  .resource-grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: 1rem; margin-top: 2.5rem; }
  .resource-link { display: flex; min-width: 0; min-height: 14rem; flex-direction: column; position: relative; padding: 1.5rem; border: 1px solid var(--rule); border-radius: 0.5rem; background: var(--surface); color: var(--ink); box-shadow: 0 14px 30px -26px color-mix(in oklab, var(--ink) 25%, transparent); transition: border-color 0.3s var(--ease), transform 0.3s var(--ease), box-shadow 0.3s var(--ease); }
  .resource-link:hover { transform: translateY(-3px); border-color: color-mix(in oklab, var(--brand) 38%, var(--rule)); box-shadow: var(--shadow-md); color: var(--ink); }
  .resource-link:first-child { background: color-mix(in oklab, var(--brand) 3%, var(--surface)); }
  .resource-icon { display: inline-flex; align-items: center; color: var(--brand-deep); }
  .resource-link:nth-child(2) .resource-icon, .resource-link:nth-child(6) .resource-icon { color: var(--ink-muted); }
  .resource-link:nth-child(3) .resource-icon { color: var(--info); }
  .resource-link:nth-child(4) .resource-icon { color: var(--success); }
  .resource-link h3 { margin: 1rem 0 0; font-family: var(--font-ui); font-size: 1.1875rem; font-weight: 600; line-height: 1.3; letter-spacing: 0; }
  .resource-link p { max-width: 36ch; margin: 0.625rem 0 1.25rem; font-size: 0.8125rem; line-height: 1.65; color: var(--ink-subtle); }
  .resource-action { display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; margin-top: auto; font-family: var(--font-ui); font-size: 0.75rem; font-weight: 500; color: var(--ink-muted); }
  .resource-action :global(svg) { flex-shrink: 0; transition: transform var(--dur) var(--ease); }
  .resource-link:hover .resource-action { color: var(--brand-deep); }
  .resource-link:hover .resource-action :global(svg) { transform: translate(2px, -2px); }
  .resource-search { display: flex; min-height: 2.75rem; align-items: center; justify-content: center; gap: 0.75rem; margin: 1.5rem auto 0; padding: 0.5rem; font-family: var(--font-ui); font-size: 0.8125rem; color: var(--ink-subtle); cursor: pointer; }
  .resource-search:hover { color: var(--brand-deep); }
  .resource-search :global(svg) { flex-shrink: 0; }
  @media (min-width: 640px) { .resource-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1000px) {
    .resources-heading h2 { font-size: 2.75rem; }
    .resource-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.25rem; }
    .resource-link { padding: 1.625rem; }
  }
  @media (prefers-reduced-motion: reduce) { .resource-link:hover, .resource-link:hover .resource-action :global(svg) { transform: none; } }
</style>
