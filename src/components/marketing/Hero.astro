---
import { Code } from "astro:components";
import ArrowDownRight from "@lucide/astro/icons/arrow-down-right";
import ArrowUpLeft from "@lucide/astro/icons/arrow-up-left";
import ChevronRight from "@lucide/astro/icons/chevron-right";
import Ellipsis from "@lucide/astro/icons/ellipsis";
import LockKeyhole from "@lucide/astro/icons/lock-keyhole";
import Search from "@lucide/astro/icons/search";
import Sparkles from "@lucide/astro/icons/sparkles";
import Icon from "../shared/Icon.astro";
import CodeTabs from "../docs/CodeTabs.astro";
import { PRODUCTS } from "../../config/products";
import { referenceHref } from "../../config/scalar";
import { LINKS, PRODUCTS as CATALOG_PRODUCTS } from "../../data/catalog";
import { buildAllNavigation } from "../../lib/api/navigation";
import type { IconName } from "../../types/icon";

const navigation = buildAllNavigation();
const operationCount = navigation.reduce((total, product) => total + product.operationCount, 0);
const areaCount = PRODUCTS.reduce((total, product) => total + product.specs.length, 0);
const featuredProduct = PRODUCTS[0];
const localEnvironment = featuredProduct.environments.find((environment) => environment.name === "Local");
if (!localEnvironment) throw new Error(`Missing local environment for ${featuredProduct.name}`);
const endpoint = "/v1/auth/me";
const operation = navigation[0].groups
  .flatMap((group) => group.tags.flatMap((tag) => tag.operations))
  .find((entry) => entry.path === endpoint && entry.method === "GET");
const endpointHref = `${referenceHref(featuredProduct.id)}${operation ? `#${operation.slug}` : ""}`;
const requestUrl = `${localEnvironment.url}${endpoint}`;

const products = [
  ...PRODUCTS.map((product) => ({
    id: product.id,
    name: product.name,
    icon: product.icon,
    kind: product.kind,
    href: referenceHref(product.id),
    availability: product.lifecycle === "development" ? "In development" : "API reference",
  })),
  ...CATALOG_PRODUCTS.filter(
    (product) => product.status === "soon" && !PRODUCTS.some((entry) => entry.name === product.name),
  ).map((product) => ({
    id: product.name.toLowerCase().replaceAll(" ", "-"),
    name: product.name,
    icon: (product.name === "Qeet Logs" ? "chart-column" : product.icon) as IconName,
    kind: product.kind,
    href: "/#products",
    availability: "Coming soon",
  })),
].slice(0, 4);

const requestTabs = [
  {
    label: "cURL",
    lang: "bash",
    code: `curl ${requestUrl} \\\n  -H "Authorization: ApiKey <your-key>" \\\n  -H "Accept: application/json"`,
  },
  {
    label: "JavaScript",
    lang: "js",
    code: `const response = await fetch(
  "${requestUrl}",
  { headers: {
    Authorization: "ApiKey <your-key>"
  }}
);
const principal = await response.json();`,
  },
  {
    label: "Go",
    lang: "go",
    code: `req, err := http.NewRequest(
  "GET", "${requestUrl}", nil,
)
if err != nil { log.Fatal(err) }
req.Header.Set("Authorization", "ApiKey <your-key>")
res, err := http.DefaultClient.Do(req)`,
  },
  {
    label: "Python",
    lang: "python",
    code: `response = requests.get(
    "${requestUrl}",
    headers={
        "Authorization": "ApiKey <your-key>"
    },
)
print(response.json())`,
  },
];

const sampleResponse = {
  principal: "usr_8f1c2a9e",
  tenant: "org_ace19f2c",
  scopes: ["identity.read", "openid"],
  authenticated: true,
};
const prettyResponse = `{
${Object.entries(sampleResponse).map(([key, value]) => `  ${JSON.stringify(key)}: ${JSON.stringify(value)}`).join(",\n")}
}`;
const authOptions = ["API key", "Bearer token", "OAuth / OIDC", "SAML / SCIM"];
const requestSteps = ["Discover", "Authenticate", "Run locally", "Inspect response"];
const resources = [
  { label: "SDKs", icon: "code", href: LINKS.sdks },
  { label: "Guides", icon: "book", href: LINKS.quickstart },
  { label: "Examples", icon: "terminal", href: endpointHref },
  { label: "OpenAPI", icon: "package", href: featuredProduct.bundleUrl },
] as const;
---

<section class="platform-hero" aria-labelledby="platform-hero-title">
  <div class="hero-grid container">
    <div class="hero-copy">
      <span class="eyebrow hero-eyebrow" data-reveal>
        <span class="hero-dot" aria-hidden="true"></span>
        Qeet Group &middot; API Platform
      </span>
      <h1 id="platform-hero-title" class="hero-title" data-reveal>
        <span>One platform</span>
        <span>for every</span>
        <span>Qeet API.</span>
      </h1>
      <p class="hero-description" data-reveal>
        The unified developer platform for current and future Qeet products.
        Explore API references, guides, SDKs, search, and OpenAPI-first workflows
        from one workspace.
      </p>

      <nav class="hero-products" aria-label="Explore Qeet product APIs" data-reveal>
        {products.map((product) => (
          <a class="hero-product-chip" href={product.href} title={`${product.name}: ${product.availability}`}>
            <span class="hero-product-icon" data-product={product.id}>
              {product.id === "qeet-id" ? (
                <>
                  <img src="/brand/logo-light.svg" alt="" width="24" height="24" class="block dark:hidden" />
                  <img src="/brand/logo-dark.svg" alt="" width="24" height="24" class="hidden dark:block" />
                </>
              ) : <Icon name={product.icon} class="h-4 w-4" />}
            </span>
            {product.name}
          </a>
        ))}
        <a class="hero-product-chip" href="/#products">
          <span class="hero-product-icon"><Ellipsis size={19} aria-hidden="true" /></span>
          More APIs
        </a>
      </nav>

      <div class="hero-actions" data-reveal>
        <a class="btn btn-primary hero-action" href={LINKS.reference}>
          Open API Reference
          <span class="btn-island"><Icon name="arrow-right" class="h-4 w-4" /></span>
        </a>
        <a class="btn hero-action" href={LINKS.quickstart}>
          View Quickstart
          <span class="btn-island"><Icon name="arrow-up-right" class="h-4 w-4" /></span>
        </a>
      </div>

      <dl class="hero-stats">
        <div><dt>API operations</dt><dd>{operationCount.toLocaleString("en-US")}</dd></div>
        <div><dt>API areas</dt><dd>{areaCount}</dd></div>
        <div><dt>Published specs</dt><dd>OpenAPI 3.1</dd></div>
        <div><dt>Build. Test. Integrate.</dt><dd>Unified workspace</dd></div>
      </dl>
    </div>

    <div class="hero-stage" aria-label="Qeet API developer workspace preview" data-reveal>
      <div class="hero-backplate" aria-hidden="true"></div>
      <div class="hero-backplate hero-backplate-secondary" aria-hidden="true"></div>
      <p class="hero-note hero-note-products" aria-hidden="true">
        Multiple products.<br />One workspace.
        <ArrowDownRight size={34} stroke-width={1} />
      </p>
      <p class="hero-note hero-note-build" aria-hidden="true">
        <Sparkles size={24} stroke-width={1} />Build. Test. Integrate.
      </p>

      <nav class="workspace-switcher" aria-label="Workspace products">
        <button class="workspace-search" type="button" data-search-trigger aria-label="Search APIs and guides" aria-haspopup="dialog">
          <Search size={13} aria-hidden="true" />
          <span>Search products...</span>
        </button>
        <p class="workspace-label">All products</p>
        <div class="workspace-products">
          {products.map((product) => (
            <a
              class:list={["workspace-product", { "is-featured": product.id === featuredProduct.id }]}
              href={product.href}
              title={`${product.name}: ${product.availability}`}
            >
              <span class="hero-product-icon" data-product={product.id}>
                {product.id === "qeet-id" ? (
                  <>
                    <img src="/brand/logo-light.svg" alt="" width="26" height="26" class="block dark:hidden" />
                    <img src="/brand/logo-dark.svg" alt="" width="26" height="26" class="hidden dark:block" />
                  </>
                ) : <Icon name={product.icon} class="h-5 w-5" />}
              </span>
              <span class="workspace-product-text">
                <strong>{product.name}</strong>
                <small>{product.availability === "API reference" ? product.kind : product.availability}</small>
              </span>
            </a>
          ))}
          <a class="workspace-product" href={LINKS.sdks}>
            <span class="hero-product-icon hero-product-icon-tools"><Icon name="terminal" class="h-5 w-5" /></span>
            <span class="workspace-product-text"><strong>SDKs &amp; Clients</strong><small>Developer tools</small></span>
          </a>
          <a class="workspace-product" href="/#products">
            <span class="hero-product-icon"><Ellipsis size={23} aria-hidden="true" /></span>
            <span class="workspace-product-text"><strong>More APIs</strong><small>Growing ecosystem</small></span>
          </a>
        </div>
      </nav>

      <div class="workspace-topbar">
        <span class="workspace-domain">api.qeet.in</span>
        <LockKeyhole size={11} aria-hidden="true" />
        <span class="workspace-local">{localEnvironment.name.toLowerCase()}</span>
        <a class="workspace-schema" href={featuredProduct.bundleUrl} title="Download the Qeet ID OpenAPI specification" download>
          <span class="hero-dot" aria-hidden="true"></span>
          OpenAPI 3.1
          <Icon name="chevron-down" class="h-3 w-3" />
        </a>
      </div>

      <div class="workspace-window">
        <div class="workspace-main">
          <section class="workspace-request" aria-label="Example local API request">
            <div class="workspace-request-bar">
              <span class="workspace-method">GET</span>
              <code>{endpoint}</code>
              <a class="workspace-send" href={endpointHref} title="Open this request in API Reference" aria-label="Open this request in API Reference">Send</a>
            </div>
            <div class="hero-request-code"><CodeTabs id="hero-request" tabs={requestTabs} /></div>
          </section>

          <section class="workspace-response" aria-label="Example API response">
            <div class="workspace-response-bar">
              <span class="workspace-method">200 OK</span>
              <span class="workspace-response-example">Example</span>
              <span class="workspace-content-type">application/json</span>
              <label class="workspace-format">
                <span class="sr-only">Response format</span>
                <select data-hero-response-format>
                  <option value="pretty">Pretty</option>
                  <option value="raw">Raw</option>
                </select>
                <Icon name="chevron-down" class="h-3 w-3" />
              </label>
            </div>
            <div class="workspace-response-code" data-hero-response="pretty" tabindex="0" aria-label="Formatted example JSON response">
              <Code code={prettyResponse} lang="json" themes={{ light: "github-light", dark: "github-dark" }} defaultColor={false} />
            </div>
            <div class="workspace-response-code" data-hero-response="raw" tabindex="0" aria-label="Raw example JSON response" hidden>
              <Code code={JSON.stringify(sampleResponse)} lang="json" themes={{ light: "github-light", dark: "github-dark" }} defaultColor={false} />
            </div>
          </section>
        </div>

        <aside class="workspace-context" aria-label="Request context">
          <div class="workspace-auth">
            <div class="workspace-panel-heading">
              <span class="workspace-label">Authentication</span>
              <a href={LINKS.authentication} class="workspace-local">ApiKey</a>
            </div>
            <ul class="workspace-auth-options">
              {authOptions.map((option, index) => (
                <li class:list={{ "is-selected": index === 0 }}><span class="hero-dot" aria-hidden="true"></span>{option}</li>
              ))}
            </ul>
          </div>

          <div class="workspace-environment">
            <p class="workspace-label">Environment</p>
            <a href={LINKS.quickstart} class="workspace-environment-value" title={localEnvironment.url}>
              <span class="hero-dot" aria-hidden="true"></span>
              {localEnvironment.name.toLowerCase()}
              <span class="workspace-loopback">localhost</span>
            </a>
          </div>

          <div class="workspace-workflow">
            <p class="workspace-panel-heading"><span class="workspace-label">Request path</span><span class="workspace-workflow-state">local</span></p>
            <ol>
              {requestSteps.map((step, index) => <li class:list={{ "is-selected": index === 1 }}><span aria-hidden="true"></span>{step}</li>)}
            </ol>
          </div>

          <a class="workspace-webhook" href={LINKS.reference}>
            <span class="workspace-webhook-icon"><Icon name="webhook" class="h-5 w-5" /></span>
            <span><strong>Signed webhooks</strong><small>HMAC signatures</small></span>
            <ChevronRight class="h-3 w-3" aria-hidden="true" />
          </a>
        </aside>
      </div>

      <nav class="workspace-dock" aria-label="Developer workspace resources">
        {resources.map((resource) => (
          <a href={resource.href} download={resource.label === "OpenAPI" ? true : undefined}>
            <Icon name={resource.icon} class="h-4.5 w-4.5" />
            {resource.label}
          </a>
        ))}
      </nav>
      <p class="hero-note hero-note-integration" aria-hidden="true">
        <ArrowUpLeft size={32} stroke-width={1} />
        From idea<br />to integration.
      </p>
    </div>
  </div>
</section>

<script>
  document.querySelector<HTMLSelectElement>("[data-hero-response-format]")?.addEventListener("change", (event) => {
    const format = (event.currentTarget as HTMLSelectElement).value;
    for (const panel of document.querySelectorAll<HTMLElement>("[data-hero-response]")) {
      panel.hidden = panel.dataset.heroResponse !== format;
    }
  });
</script>

<style>
  .platform-hero {
    --hero-rule: color-mix(in oklab, var(--ink) 7%, var(--surface));
    --hero-muted: color-mix(in oklab, var(--ink) 60%, var(--surface));
    --hero-wash: color-mix(in oklab, var(--ink) 2.5%, var(--surface));
    --hero-blue: #0879ef;
    --hero-green: #009e52;
    --hero-violet: #813ee5;
    position: relative;
    isolation: isolate;
    overflow: clip;
    letter-spacing: 0;
  }
  .platform-hero::before {
    position: absolute;
    z-index: -1;
    inset: 0;
    content: "";
    background-image: linear-gradient(var(--hero-rule) 1px, transparent 1px), linear-gradient(90deg, var(--hero-rule) 1px, transparent 1px);
    background-size: 50px 50px;
    mask-image: linear-gradient(#0006, transparent 82%);
    pointer-events: none;
  }
  .hero-grid {
    display: grid;
    gap: 3.5rem;
    max-width: 76.75rem;
    padding-top: 2.5rem;
    padding-bottom: 2.5rem;
  }
  .hero-copy { min-width: 0; }
  .hero-eyebrow { gap: 0.5rem; letter-spacing: 0; }
  .hero-dot { display: inline-block; width: 0.4375rem; height: 0.4375rem; flex-shrink: 0; border-radius: 50%; background: var(--brand); }
  .hero-title { margin: 1.25rem 0 0; font-size: 2.5rem; font-weight: 600; line-height: 0.96; letter-spacing: 0; }
  .hero-title span { display: block; }
  .hero-description { max-width: 30rem; margin: 1.4rem 0 0; font-size: 1.0625rem; line-height: 1.55; color: var(--ink-muted); text-wrap: pretty; }
  .hero-products { display: flex; flex-wrap: wrap; align-items: center; gap: 0.375rem; margin-top: 1.375rem; }
  .hero-product-chip { display: inline-flex; min-height: 2.5rem; align-items: center; gap: 0.3125rem; border: 1px solid var(--hero-rule); border-radius: 999px; padding: 0.3125rem 0.375rem 0.3125rem 0.25rem; background: var(--surface); font-family: var(--font-ui); font-size: 0.6875rem; font-weight: 500; color: var(--ink); box-shadow: 0 3px 8px -5px var(--rule-strong); transition: transform var(--dur) var(--ease), border-color var(--dur) var(--ease); }
  .hero-product-chip:hover { transform: translateY(-2px); border-color: var(--brand); color: var(--ink); }
  .hero-product-icon { display: grid; width: 1.625rem; height: 1.625rem; flex-shrink: 0; place-items: center; border-radius: 0.5rem; background: var(--hero-wash); color: var(--ink-muted); }
  .hero-product-icon[data-product="qeet-id"] { background: var(--brand-faint); }
  .hero-product-icon[data-product="qeet-notify"] { background: color-mix(in oklab, var(--hero-blue) 9%, var(--surface)); color: var(--hero-blue); }
  .hero-product-icon[data-product="qeet-pay"] { background: color-mix(in oklab, var(--hero-green) 10%, var(--surface)); color: var(--hero-green); }
  .hero-product-icon[data-product="qeet-logs"] { background: color-mix(in oklab, var(--hero-violet) 10%, var(--surface)); color: var(--hero-violet); }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.125rem; }
  .hero-action { min-height: 3rem; padding: 0.5rem 0.5rem 0.5rem 1.25rem; font-size: 0.8125rem; }
  .hero-action:not(.btn-primary) { border-color: var(--hero-rule); }
  .hero-action .btn-island { width: 1.875rem; height: 1.875rem; }
  .hero-stats { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.25rem 0; margin: 2.5rem 0 0; }
  .hero-stats > div { display: flex; min-width: 0; flex-direction: column-reverse; justify-content: flex-end; gap: 0.25rem; padding-inline: 1rem; border-left: 1px solid var(--hero-rule); }
  .hero-stats > div:first-child { padding-left: 0; border: 0; }
  .hero-stats dt { font-size: 0.75rem; line-height: 1.4; color: var(--hero-muted); }
  .hero-stats dd { display: flex; min-height: 2.25rem; align-items: center; margin: 0; font-family: var(--font-display); font-size: 1.1875rem; font-weight: 500; line-height: 1.2; white-space: nowrap; }
  .hero-stats > div:nth-child(-n + 2) dd { font-size: 1.8125rem; font-variant-numeric: tabular-nums; }
  .hero-stage { position: relative; isolation: isolate; min-width: 0; width: 100%; max-width: 43rem; margin-inline: auto; font-family: var(--font-ui); }
  .hero-backplate { position: absolute; z-index: -1; top: 7rem; left: -3.5rem; width: 30rem; height: 23rem; border-radius: 2rem; background: color-mix(in oklab, var(--brand) 19%, var(--bg)); transform: rotate(-20deg); transform-origin: top left; pointer-events: none; }
  .hero-backplate-secondary { top: 4rem; left: auto; right: -0.625rem; width: 22rem; height: 15rem; transform: rotate(-16deg); transform-origin: center; }
  .hero-note { display: none; position: absolute; margin: 0; font-family: "Bradley Hand", "Segoe Print", "Comic Sans MS", cursive; font-size: 1rem; font-weight: 400; line-height: 1.05; color: var(--hero-muted); pointer-events: none; }
  .hero-note-products { top: -3.25rem; left: -2rem; transform: rotate(-12deg); }
  .hero-note-products :global(svg) { display: block; margin: 0.375rem 0 0 2.5rem; transform: rotate(24deg); }
  .hero-note-build { top: -2.75rem; right: -1.5rem; display: none; align-items: center; gap: 0.375rem; transform: rotate(-9deg); }
  .hero-note-build :global(svg) { color: var(--brand); }
  .hero-note-integration { right: -1.25rem; bottom: -2.5rem; transform: rotate(-11deg); }
  .hero-note-integration :global(svg) { display: block; margin-bottom: 0.125rem; }
  .workspace-switcher { position: relative; margin: 0 0 0.75rem; padding: 0.5rem; border: 1px solid var(--hero-rule); border-radius: 1rem; background: var(--surface); box-shadow: var(--shadow-lg), inset 0 1px 0 var(--surface); }
  .workspace-search { display: flex; width: 100%; min-height: 2.5rem; align-items: center; gap: 0.375rem; padding: 0.5rem; border: 1px solid var(--hero-rule); border-radius: 0.625rem; background: var(--surface); font-size: 0.6875rem; color: var(--hero-muted); cursor: pointer; text-align: left; }
  .workspace-label { margin: 0; font-size: 0.5625rem; font-weight: 600; line-height: 1.4; text-transform: uppercase; color: var(--hero-muted); }
  .workspace-switcher > .workspace-label { margin: 1rem 0 0.5rem 0.25rem; }
  .workspace-products { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.125rem; }
  .workspace-product { display: flex; min-width: 0; min-height: 3.0625rem; align-items: center; gap: 0.5rem; padding: 0.4375rem; border-radius: 0.625rem; color: var(--ink); transition: background var(--dur) var(--ease); }
  .workspace-product:hover { background: var(--hero-wash); color: var(--ink); }
  .workspace-product.is-featured { background: color-mix(in oklab, var(--brand) 5%, var(--surface)); }
  .workspace-product .hero-product-icon { width: 2rem; height: 2rem; }
  .workspace-product-text { min-width: 0; }
  .workspace-product strong { display: block; font-size: 0.625rem; font-weight: 600; line-height: 1.5; }
  .workspace-product small { display: block; font-size: 0.5625rem; line-height: 1.6; color: var(--hero-muted); }
  .workspace-product :global(.shrink-0) { margin-left: auto; color: var(--ink-subtle); }
  .hero-product-icon-tools { background: var(--ink); color: var(--bg); }
  .workspace-topbar { position: relative; z-index: var(--z-raised); display: flex; min-height: 2.5rem; align-items: center; gap: 0.6875rem; padding: 0.375rem 0.75rem; border: 1px solid var(--hero-rule); border-radius: 0.875rem 0.875rem 0 0; background: var(--hero-wash); color: var(--hero-muted); box-shadow: 0 -5px 0 1px color-mix(in oklab, var(--surface) 70%, transparent); }
  .workspace-domain { font-family: var(--font-mono); font-size: 0.625rem; }
  .workspace-local { display: inline-flex; align-items: center; border-radius: 999px; padding: 0.1875rem 0.5rem; background: var(--brand-faint); font-size: 0.625rem; color: var(--brand-deep); }
  .workspace-schema { display: inline-flex; align-items: center; gap: 0.375rem; margin-left: auto; padding: 0.3125rem 0.5rem; border: 1px solid var(--hero-rule); border-radius: 999px; background: var(--surface); font-size: 0.5625rem; font-weight: 600; color: var(--ink); white-space: nowrap; }
  .workspace-schema .hero-dot { background: var(--hero-green); }
  .workspace-window { position: relative; z-index: var(--z-raised); display: grid; gap: 0.75rem; padding: 0.75rem; border: 1px solid var(--hero-rule); border-top: 0; border-radius: 0 0 0.875rem 0.875rem; background: var(--surface); box-shadow: 0 24px 55px -30px color-mix(in oklab, var(--ink) 24%, transparent), 0 0 0 5px color-mix(in oklab, var(--surface) 65%, transparent); }
  .workspace-main { display: grid; min-width: 0; gap: 0.75rem; grid-template-rows: 11.25rem 13.625rem; }
  .workspace-request, .workspace-response, .workspace-auth, .workspace-environment, .workspace-workflow, .workspace-webhook { min-width: 0; border: 1px solid var(--hero-rule); border-radius: 0.75rem; padding: 0.625rem; background: var(--surface); }
  .workspace-request-bar { display: flex; align-items: center; gap: 0.625rem; min-height: 2rem; padding-bottom: 0.4375rem; border-bottom: 1px solid var(--hero-rule); }
  .workspace-method { display: inline-flex; flex-shrink: 0; align-items: center; justify-content: center; padding: 0.3125rem 0.625rem; border-radius: 0.5rem; background: color-mix(in oklab, var(--hero-green) 10%, var(--surface)); font-family: var(--font-mono); font-size: 0.625rem; font-weight: 600; line-height: 1.4; color: var(--hero-green); }
  .workspace-request-bar > code { min-width: 0; font-size: 0.6875rem; font-weight: 500; color: var(--ink); }
