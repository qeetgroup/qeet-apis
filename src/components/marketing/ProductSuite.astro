---
import ArrowDownLeft from "@lucide/astro/icons/arrow-down-left";
import ArrowUpLeft from "@lucide/astro/icons/arrow-up-left";
import UserRound from "@lucide/astro/icons/user-round";
import Grip from "@lucide/astro/icons/grip";
import Icon from "../shared/Icon.astro";
import { PRODUCTS } from "../../config/products";
import { referenceHref } from "../../config/scalar";
import { LINKS, PRODUCTS as CATALOG_PRODUCTS } from "../../data/catalog";
import type { IconName } from "../../types/icon";

const presentation: Record<string, { kind: string; description: string; icon: IconName }> = {
  "qeet-id": {
    kind: "Identity & access",
    description: "Authentication, user identity, permissions, and more.",
    icon: "fingerprint",
  },
  "qeet-notify": {
    kind: "Messaging & events",
    description: "Transactional notifications, webhooks, and event delivery.",
    icon: "bell",
  },
  "qeet-pay": {
    kind: "Payments & billing",
    description: "Payments, subscriptions, refunds, and billing workflows.",
    icon: "credit-card",
  },
  "qeet-logs": {
    kind: "Audit & analytics",
    description: "Privacy-first logs and identity-aware audit trails.",
    icon: "chart-column",
  },
};

const featuredProducts = [
  ...PRODUCTS.map((product) => ({
    id: product.id,
    name: product.name,
    kind: presentation[product.id]?.kind ?? product.kind,
    description: presentation[product.id]?.description ?? product.description,
    icon: presentation[product.id]?.icon ?? product.icon,
    href: referenceHref(product.id),
    external: false,
    availability: product.lifecycle === "development" ? "In development" : "",
  })),
  ...CATALOG_PRODUCTS.filter(
    (product) =>
      product.status === "soon" && !PRODUCTS.some((entry) => entry.name === product.name),
  ).map((product) => {
    const id = product.name.toLowerCase().replaceAll(" ", "-");
    return {
      id,
      name: product.name,
      kind: presentation[id]?.kind ?? product.kind,
      description: presentation[id]?.description ?? product.blurb,
      icon: presentation[id]?.icon ?? (product.icon as IconName),
      href: product.href,
      external: product.external ?? false,
      availability: "Coming soon",
    };
  }),
].slice(0, 4);

const cards = [
  ...featuredProducts,
  {
    id: "qeet-console",
    name: "Qeet Console",
    kind: "Developer tools",
    description: "Manage API keys, tenants, and identity settings.",
    icon: "terminal" as const,
    href: LINKS.console,
    external: true,
    availability: "",
  },
  {
    id: "more-apis",
    name: "More APIs",
    kind: "Growing ecosystem",
    description: "New products. The same developer experience.",
    icon: "plus" as const,
    href: LINKS.reference,
    external: false,
    availability: "",
  },
];

const foundations = [
  { title: "Unified navigation", text: "All products in one place", icon: "layers" },
  { title: "Shared auth patterns", text: "Clear, product-specific credentials", icon: "key" },
  { title: "OpenAPI-first", text: "Consistent, developer-friendly", icon: "book" },
  { title: "Built to scale across products", text: "Today and what's next", icon: "chart-column" },
] as const;
---

<section class="product-ecosystem" id="products" aria-labelledby="ecosystem-title">
  <div class="ecosystem-container container container-wide">
    <div class="ecosystem-main">
      <div class="ecosystem-copy">
        <span class="eyebrow ecosystem-eyebrow"><span aria-hidden="true"></span>Product ecosystem</span>
        <h2 class="ecosystem-title" id="ecosystem-title">
          <span>Every Qeet product.</span>{" "}
          <span>One developer experience.</span>
        </h2>
        <p class="ecosystem-description">
          Explore current and future Qeet APIs from one consistent platform, with
          shared reference, guides, SDKs, authentication patterns, and OpenAPI-first workflows.
        </p>
        <div class="ecosystem-actions">
          <a class="btn btn-primary ecosystem-action" href={LINKS.reference}>
            Explore all APIs
            <span class="btn-island"><Icon name="arrow-right" class="h-4 w-4" /></span>
          </a>
          <a class="btn ecosystem-action" href={LINKS.quickstart}>
            View documentation
            <span class="btn-island"><Icon name="arrow-up-right" class="h-4 w-4" /></span>
          </a>
        </div>
      </div>

      <div class="ecosystem-catalog">
        <div class="ecosystem-backplate" aria-hidden="true"></div>
        <p class="ecosystem-note ecosystem-note-products" aria-hidden="true">
          Current products.<br />Many more to come.
          <ArrowDownLeft size={34} stroke-width={1} />
        </p>
        <div class="ecosystem-cards">
          {cards.map((card) => (
            <a
              class="ecosystem-card"
              href={card.href}
              target={card.external ? "_blank" : undefined}
              rel={card.external ? "noopener noreferrer" : undefined}
              aria-label={`${card.name}${card.availability ? ` (${card.availability})` : ""}${card.external ? ", opens in a new tab" : ""}`}
              data-product={card.id}
            >
              <div class="ecosystem-card-top">
                <span class="ecosystem-product-mark" data-product={card.id}>
                  {card.id === "qeet-id" ? <UserRound size={29} stroke-width={2} aria-hidden="true" />
                    : card.id === "more-apis" ? <Grip size={29} stroke-width={2.5} aria-hidden="true" />
                    : <Icon name={card.icon} class="h-7 w-7" />}
                </span>
                {card.availability && <span class="ecosystem-availability">{card.availability}</span>}
                <span class="ecosystem-card-arrow" aria-hidden="true"><Icon name="arrow-right" class="h-3.5 w-3.5" /></span>
              </div>
              <h3>{card.name}</h3>
              <p class="ecosystem-card-kind">{card.kind}</p>
              <p class="ecosystem-card-description">{card.description}</p>
            </a>
          ))}
        </div>
      </div>
    </div>

    <ul class="ecosystem-foundations" aria-label="Shared developer platform foundations">
      {foundations.map((foundation) => (
        <li>
          <span class="ecosystem-foundation-icon"><Icon name={foundation.icon} class="h-5 w-5" /></span>
          <span><strong>{foundation.title}</strong><small>{foundation.text}</small></span>
        </li>
      ))}
    </ul>
    <p class="ecosystem-note ecosystem-note-scale" aria-hidden="true">
      <ArrowUpLeft size={34} stroke-width={1} />
      <span>A platform<br />that grows with you.</span>
    </p>
  </div>
</section>

<style>
  .product-ecosystem {
    --ecosystem-rule: color-mix(in oklab, var(--ink) 7%, var(--surface));
    --ecosystem-muted: color-mix(in oklab, var(--ink) 62%, var(--surface));
    --ecosystem-blue: #0879ef;
    --ecosystem-green: #009e52;
    --ecosystem-violet: #813ee5;
    position: relative;
    isolation: isolate;
    overflow: clip;
    padding-block: 4rem;
    letter-spacing: 0;
    scroll-margin-top: var(--header-h);
  }
  .product-ecosystem::before {
    position: absolute;
    z-index: -1;
    inset: 0;
    content: "";
    background-image: linear-gradient(var(--ecosystem-rule) 1px, transparent 1px), linear-gradient(90deg, var(--ecosystem-rule) 1px, transparent 1px);
    background-size: 80px 80px;
    mask-image: linear-gradient(#0005, transparent 78%);
    pointer-events: none;
  }
  .ecosystem-container { position: relative; }
  .ecosystem-main { display: grid; gap: 2.5rem; }
  .ecosystem-copy { min-width: 0; max-width: 40rem; container-type: inline-size; }
  .ecosystem-eyebrow { gap: 0.5rem; letter-spacing: 0; }
  .ecosystem-eyebrow > span { width: 0.5rem; height: 0.5rem; border-radius: 50%; background: var(--brand); }
  .ecosystem-title { margin: 1.25rem 0 0; font-size: 1.25rem; font-weight: 600; line-height: 1.12; letter-spacing: 0; }
  .ecosystem-title > span { display: block; white-space: nowrap; }
  .ecosystem-description { margin: 1.125rem 0 0; font-size: 1rem; line-height: 1.55; color: var(--ink-muted); text-wrap: pretty; }
  .ecosystem-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.25rem; }
  .ecosystem-action { min-height: 3rem; padding: 0.5rem 0.5rem 0.5rem 1.375rem; font-size: 0.8125rem; }
  .ecosystem-action:not(.btn-primary) { border-color: var(--ecosystem-rule); }
  .ecosystem-action .btn-island { width: 1.875rem; height: 1.875rem; }
  .ecosystem-catalog { position: relative; isolation: isolate; min-width: 0; }
  .ecosystem-backplate { position: absolute; z-index: -1; inset: 0 0.5rem 1rem 16%; border-radius: 2rem; background: color-mix(in oklab, var(--brand) 11%, var(--bg)); transform: rotate(-20deg); pointer-events: none; }
  .ecosystem-cards { display: grid; grid-template-columns: minmax(0, 1fr); gap: 0.875rem; }
  .ecosystem-card { display: flex; min-width: 0; min-height: 12.375rem; flex-direction: column; padding: 1.3125rem; border: 1px solid var(--ecosystem-rule); border-radius: 1rem; background: color-mix(in oklab, var(--surface) 97%, transparent); color: var(--ink); box-shadow: 0 16px 36px -28px color-mix(in oklab, var(--ink) 16%, transparent), inset 0 1px 0 var(--surface); transition: transform 0.35s var(--ease-heavy), box-shadow 0.35s var(--ease-heavy), border-color 0.35s var(--ease-heavy); }
  .ecosystem-card:hover { transform: translateY(-4px); border-color: color-mix(in oklab, var(--brand) 26%, var(--ecosystem-rule)); color: var(--ink); box-shadow: 0 22px 38px -28px color-mix(in oklab, var(--ink) 25%, transparent); }
  .ecosystem-card:focus-visible { outline-offset: 4px; }
  .ecosystem-card-top { display: flex; min-height: 3.25rem; align-items: flex-start; gap: 0.5rem; }
  .ecosystem-product-mark { display: grid; width: 3.25rem; height: 3.25rem; flex-shrink: 0; place-items: center; border-radius: 0.875rem; background: var(--brand-faint); color: var(--brand); }
  .ecosystem-product-mark[data-product="qeet-notify"] { background: color-mix(in oklab, var(--ecosystem-blue) 10%, var(--surface)); color: var(--ecosystem-blue); }
  .ecosystem-product-mark[data-product="qeet-notify"] :global(svg) { fill: currentColor; }
  .ecosystem-product-mark[data-product="qeet-pay"] { background: color-mix(in oklab, var(--ecosystem-green) 11%, var(--surface)); color: var(--ecosystem-green); }
  .ecosystem-product-mark[data-product="qeet-pay"] :global(rect) { fill: currentColor; }
  .ecosystem-product-mark[data-product="qeet-pay"] :global(path), .ecosystem-product-mark[data-product="qeet-pay"] :global(line) { stroke: var(--surface); }
  .ecosystem-product-mark[data-product="qeet-logs"] { background: color-mix(in oklab, var(--ecosystem-violet) 11%, var(--surface)); color: var(--ecosystem-violet); }
  .ecosystem-product-mark[data-product="qeet-logs"] :global(rect) { fill: currentColor; }
  .ecosystem-product-mark[data-product="qeet-console"] { background: color-mix(in oklab, var(--ink) 6%, var(--surface)); color: var(--surface); }
  .ecosystem-product-mark[data-product="qeet-console"] :global(svg) { width: 1.875rem; height: 1.875rem; padding: 0.25rem; border-radius: 0.3125rem; background: var(--ink); box-shadow: var(--shadow-sm); }
  .ecosystem-availability { align-self: center; margin-left: auto; padding: 0.1875rem 0.3125rem; border-radius: 0.375rem; background: var(--surface-2); font-family: var(--font-ui); font-size: 0.5625rem; font-weight: 500; line-height: 1.35; color: var(--ecosystem-muted); }
  .ecosystem-card-arrow { display: grid; width: 1.625rem; height: 1.625rem; flex-shrink: 0; place-items: center; margin: 0.125rem 0 0 auto; border: 1px solid var(--ecosystem-rule); border-radius: 50%; background: var(--surface); box-shadow: var(--shadow-sm); color: var(--ink-muted); transition: transform 0.35s var(--ease-heavy), color 0.35s var(--ease-heavy); }
  .ecosystem-card:hover .ecosystem-card-arrow { transform: translateX(2px); color: var(--brand); }
  .ecosystem-card h3 { margin: 0.625rem 0 0; font-size: 1.25rem; font-weight: 600; line-height: 1.25; letter-spacing: 0; }
  .ecosystem-card-kind { margin: 0.125rem 0 0; font-family: var(--font-ui); font-size: 0.8125rem; font-weight: 500; line-height: 1.45; color: var(--ink-muted); }
  .ecosystem-card-description { margin: 0.375rem 0 0; font-size: 0.78125rem; line-height: 1.55; color: var(--ecosystem-muted); }
  .ecosystem-foundations { position: relative; z-index: var(--z-raised); display: grid; grid-template-columns: minmax(0, 1fr); gap: 1rem; margin: 2rem 0 0; padding: 1.125rem; list-style: none; border: 1px solid var(--ecosystem-rule); border-radius: 1rem; background: color-mix(in oklab, var(--surface) 95%, transparent); box-shadow: 0 18px 40px -30px color-mix(in oklab, var(--ink) 16%, transparent); }
  .ecosystem-foundations li { display: flex; min-width: 0; align-items: center; gap: 1rem; }
  .ecosystem-foundation-icon { display: grid; width: 2.875rem; height: 2.875rem; flex-shrink: 0; place-items: center; border-radius: 50%; background: var(--brand-faint); color: var(--brand); }
  .ecosystem-foundations strong { display: block; font-family: var(--font-ui); font-size: 0.8125rem; font-weight: 600; line-height: 1.4; }
  .ecosystem-foundations small { display: block; margin-top: 0.25rem; font-size: 0.75rem; line-height: 1.4; color: var(--ecosystem-muted); }
  .ecosystem-note { display: none; position: absolute; margin: 0; font-family: "Bradley Hand", "Segoe Print", "Comic Sans MS", cursive; font-size: 1rem; line-height: 1.15; color: var(--ecosystem-muted); pointer-events: none; }
  .ecosystem-note-products { top: -5.375rem; right: -0.9375rem; transform: rotate(-8deg); }
  .ecosystem-note-products :global(svg) { display: block; margin: 0.25rem 0 0 4.5rem; transform: rotate(-18deg); }
  .ecosystem-note-scale { right: 1.5rem; bottom: -3.5rem; align-items: flex-start; gap: 0.5rem; transform: rotate(-7deg); }
  :global([data-theme="dark"]) .product-ecosystem { --ecosystem-blue: #65b1ff; --ecosystem-green: #57c88c; --ecosystem-violet: #bb97ff; }

  @media (min-width: 540px) {
    .ecosystem-cards, .ecosystem-foundations { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 768px) {
    .ecosystem-cards { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .ecosystem-card { min-height: 12.375rem; }
  }
  @media (min-width: 1200px) {
    .product-ecosystem { padding-top: 6rem; padding-bottom: 4.5rem; }
    .ecosystem-main { grid-template-columns: minmax(0, 0.615fr) minmax(0, 0.385fr); grid-template-areas: "catalog copy"; align-items: center; gap: 3rem; }
    .ecosystem-copy { grid-area: copy; }
    .ecosystem-catalog { grid-area: catalog; align-self: center; width: 100%; margin-top: 0; }
    .ecosystem-backplate { inset: 1.5rem -1.25rem auto 16%; height: 14.375rem; }
    .ecosystem-foundations { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0; padding: 1.125rem 0; }
    .ecosystem-foundations li { min-height: 3.25rem; padding-inline: 1.375rem; }
    .ecosystem-foundations li + li { border-left: 1px solid var(--ecosystem-rule); }
    .ecosystem-foundations strong { font-size: 0.75rem; }
    .ecosystem-foundations small { font-size: 0.6875rem; }
    .ecosystem-note-products { display: block; }
    .ecosystem-note-scale { display: flex; }
  }
  @media (max-width: 539px) {
    .ecosystem-backplate { inset: 0.5rem -0.5rem; transform: none; }
    .ecosystem-card { min-height: 11.875rem; }
    .ecosystem-foundations li + li { padding-top: 1rem; border-top: 1px solid var(--ecosystem-rule); }
  }
  @container (min-width: 20rem) { .ecosystem-title { font-size: 1.5rem; } }
  @container (min-width: 22rem) { .ecosystem-title { font-size: 1.625rem; } }
  @container (min-width: 24rem) { .ecosystem-title { font-size: 1.75rem; } }
  @container (min-width: 28rem) { .ecosystem-title { font-size: 2rem; } }
  @container (min-width: 34rem) { .ecosystem-title { font-size: 2.5rem; } }
  @container (min-width: 40rem) { .ecosystem-title { font-size: 2.75rem; } }
  @media (prefers-reduced-motion: reduce) {
    .ecosystem-card, .ecosystem-card-arrow { transition: none; }
    .ecosystem-card:hover, .ecosystem-card:hover .ecosystem-card-arrow { transform: none; }
  }
</style>
