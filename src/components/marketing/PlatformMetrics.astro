---
import Icon from "../shared/Icon.astro";
import { PRODUCTS } from "../../config/products";
import { buildAllNavigation } from "../../lib/api/navigation";
import { LINKS } from "../../data/catalog";

const navigation = buildAllNavigation();
const metrics = [
  {
    value: navigation.reduce((total, product) => total + product.operationCount, 0),
    label: "Documented operations",
    detail: "Across the published product bundles",
  },
  {
    value: PRODUCTS.reduce((total, product) => total + product.specs.length, 0),
    label: "API areas",
    detail: "Organized by product and capability",
  },
  {
    value: PRODUCTS.length,
    label: "Product references",
    detail: "One extensible developer platform",
  },
];
const foundations = [
  {
    icon: "braces",
    title: "OpenAPI-first contracts",
    text: "Versioned specifications describe endpoints, schemas, and authentication.",
  },
  {
    icon: "circle-check",
    title: "Vendored. Validated. Committed.",
    text: "CI checks references, operation IDs, and consistency between split and bundled specs.",
  },
  {
    icon: "key",
    title: "Product-scoped credentials",
    text: "Use the authentication scheme and permissions defined by each product.",
  },
  {
    icon: "alert",
    title: "Documented error handling",
    text: "Error envelopes, HTTP status codes, and retry guidance in one place.",
  },
  {
    icon: "search",
    title: "Searchable by design",
    text: "Guides, tags, and operations feed the same cross-product search index.",
  },
  {
    icon: "layers",
    title: "Ready for more products",
    text: "A shared product registry powers navigation, environments, and reference routes.",
  },
] as const;
const pipeline = [
  { label: "Source specs", icon: "git-branch" },
  { label: "Vendor & bundle", icon: "package" },
  { label: "Validate in CI", icon: "circle-check" },
  { label: "Reference & search", icon: "book" },
] as const;
---

<section class="engineering-foundations" id="engineering" aria-labelledby="engineering-title">
  <div class="container container-wide engineering-inner">
    <div class="engineering-overview" data-reveal>
      <header class="engineering-heading">
        <span class="engineering-eyebrow"><Icon name="git-branch" class="h-4 w-4" />The contract comes first</span>
        <h2 id="engineering-title">Engineered for a<br class="hidden sm:block" /> <span>growing API platform.</span></h2>
        <p>More products. The same discipline. Open specifications, checked into source control and built into one developer experience.</p>
        <a class="engineering-explore" href={LINKS.reference}>Explore the API surface <Icon name="arrow-up-right" class="h-4 w-4" /></a>
      </header>

      <figure class="contract-composition" aria-label="Versioned product specifications">
        <div class="contract-origin"><Icon name="git-branch" class="h-4 w-4" /><code>public/specs/</code><span>Source controlled</span></div>
        <div class="contract-files">
          {PRODUCTS.slice(0, 3).map((product) => {
            const specification = navigation.find((entry) => entry.productId === product.id);
            return (
              <a class="contract-file" href={product.bundleUrl} download aria-label={`Download ${product.name} OpenAPI specification`}>
                <span class="contract-file-icon"><Icon name={product.icon} class="h-5 w-5" /></span>
                <code class="contract-filename">{product.id}.yaml</code>
                <strong>{product.name}</strong>
                <span class="contract-version">{specification?.version ?? product.version}</span>
                <span class="contract-count"><b>{specification?.operationCount ?? 0}</b> operations</span>
                <span class="contract-download">OpenAPI 3.1 <Icon name="download" class="h-3.5 w-3.5" /></span>
              </a>
            );
          })}
        </div>
        <figcaption><span></span>Product contracts. Shared conventions.<span></span></figcaption>
      </figure>
    </div>

    <dl class="engineering-metrics">
      {metrics.map((metric) => (
        <div><dt>{metric.label}<span>{metric.detail}</span></dt><dd>{metric.value.toLocaleString("en-US")}</dd></div>
      ))}
    </dl>

    <div class="engineering-pipeline-wrap">
      <span class="engineering-pipeline-label">From source to reference</span>
      <ol class="engineering-pipeline" aria-label="Specification publishing pipeline">
        {pipeline.map((stage) => <li><span class="pipeline-icon"><Icon name={stage.icon} class="h-4.5 w-4.5" /></span><span>{stage.label}</span><Icon name="arrow-right" class="pipeline-arrow h-4 w-4" /></li>)}
      </ol>
    </div>

    <div class="engineering-principles">
      {foundations.map((foundation) => (
        <article><Icon name={foundation.icon} class="h-5 w-5" /><div><h3>{foundation.title}</h3><p>{foundation.text}</p></div></article>
      ))}
    </div>

    <div class="engineering-specs" id="specifications">
      <span><Icon name="download" class="h-4 w-4" />Published specifications</span>
      <nav aria-label="Download product OpenAPI specifications">
        {PRODUCTS.map((product) => (
          <a href={product.bundleUrl} download>{product.name}<code>{navigation.find((entry) => entry.productId === product.id)?.version ?? product.version}</code><Icon name="download" class="h-3.5 w-3.5" /></a>
        ))}
      </nav>
    </div>
  </div>
</section>

<style>
  .engineering-foundations { --engineering-bg: #111312; --engineering-text: #f6f7f5; --engineering-muted: #aab0ac; --engineering-rule: #303633; --engineering-accent: #ff9955; --engineering-green: #8cd6b6; position: relative; isolation: isolate; overflow: clip; padding-block: 5rem 2rem; border-top: 1px solid #414139; background: linear-gradient(135deg, #1d201c, var(--engineering-bg) 48%); color: var(--engineering-text); scroll-margin-top: var(--header-h); }
  .engineering-foundations::before { position: absolute; z-index: -1; inset: 0; background-image: linear-gradient(var(--engineering-rule) 1px, transparent 1px), linear-gradient(90deg, var(--engineering-rule) 1px, transparent 1px); background-size: 80px 80px; mask-image: linear-gradient(115deg, transparent 25%, #0005 100%); content: ""; pointer-events: none; }
  .engineering-inner { position: relative; }
  .engineering-overview { display: grid; align-items: center; gap: 3rem; }
  .engineering-heading { max-width: 40rem; }
  .engineering-eyebrow { display: flex; align-items: center; gap: 0.625rem; margin-bottom: 1.25rem; font-family: var(--font-mono); font-size: 0.6875rem; color: var(--engineering-accent); }
  .engineering-heading h2 { margin: 0; font-size: 2rem; line-height: 1.14; letter-spacing: 0; color: var(--engineering-text); }
  .engineering-heading h2 > span { color: #cdd4cb; }
  .engineering-heading p { max-width: 33rem; margin: 1.25rem 0 0; font-size: 0.9375rem; line-height: 1.7; color: var(--engineering-muted); }
  .engineering-explore { display: inline-flex; min-height: 2.75rem; align-items: center; gap: 0.75rem; margin-top: 1.25rem; font-family: var(--font-ui); font-size: 0.8125rem; font-weight: 500; color: var(--engineering-accent); }
  .engineering-explore:hover { color: var(--engineering-text); }
  .contract-composition { position: relative; isolation: isolate; min-width: 0; margin: 0; }
  .contract-composition::before { position: absolute; z-index: -1; inset: 3.5rem 2rem 3rem; content: ""; border: 1px solid #3e453d; border-radius: 0.75rem; background: #1b201b; transform: rotate(-7deg); }
  .contract-origin { display: flex; align-items: center; gap: 0.625rem; margin-bottom: 2rem; padding-bottom: 0.875rem; border-bottom: 1px solid var(--engineering-rule); color: var(--engineering-muted); }
  .contract-origin code { font-size: 0.6875rem; }
  .contract-origin > span { margin-left: auto; font-family: var(--font-ui); font-size: 0.625rem; }
  .contract-files { display: grid; grid-template-columns: minmax(0, 1fr); gap: 0.75rem; }
  .contract-file { display: grid; min-width: 0; position: relative; gap: 0.625rem; padding: 1.25rem; border: 1px solid #41473f; border-radius: 0.5rem; background: linear-gradient(150deg, #2a3028, #191d19 72%); color: var(--engineering-text); box-shadow: inset 0 1px 0 #ffffff09, 0 22px 42px -25px #0009; transition: transform 0.35s var(--ease), border-color 0.35s var(--ease); }
  .contract-file:hover { border-color: var(--engineering-accent); color: var(--engineering-text); transform: translateY(-5px); }
  .contract-file-icon { display: grid; width: 2.5rem; height: 2.5rem; place-items: center; margin-bottom: 0.125rem; border: 1px solid #4b5344; border-radius: 0.5rem; background: #30382b; color: var(--engineering-accent); }
  .contract-filename { overflow-wrap: anywhere; font-size: 0.5625rem; line-height: 1.5; color: var(--engineering-muted); }
  .contract-file strong { font-family: var(--font-ui); font-size: 0.9375rem; font-weight: 500; line-height: 1.3; }
  .contract-version { width: fit-content; padding: 0.125rem 0.375rem; border: 1px solid var(--engineering-rule); border-radius: 0.25rem; font-family: var(--font-mono); font-size: 0.5625rem; color: var(--engineering-green); }
  .contract-count { margin-top: 0.375rem; font-size: 0.625rem; color: var(--engineering-muted); }
  .contract-count b { margin-right: 0.25rem; font-family: var(--font-mono); font-size: 1.125rem; font-weight: 400; color: var(--engineering-text); }
  .contract-download { display: flex; align-items: center; justify-content: space-between; gap: 0.375rem; margin-top: 0.375rem; padding-top: 0.875rem; border-top: 1px solid var(--engineering-rule); font-family: var(--font-mono); font-size: 0.5625rem; color: var(--engineering-muted); }
  .contract-download :global(svg) { flex-shrink: 0; }
  .contract-composition figcaption { display: flex; align-items: center; justify-content: center; gap: 0.875rem; margin-top: 1.75rem; font-family: var(--font-mono); font-size: 0.625rem; text-align: center; color: var(--engineering-muted); }
  .contract-composition figcaption > span { width: 1.75rem; height: 1px; background: var(--engineering-rule); }
  .engineering-metrics { display: grid; gap: 1.75rem; margin: 3rem 0 2rem; padding-block: 1.75rem; border-block: 1px solid var(--engineering-rule); }
  .engineering-metrics > div { display: flex; min-width: 0; align-items: center; gap: 1.5rem; }
  .engineering-metrics dt { order: 1; font-family: var(--font-ui); font-size: 0.875rem; font-weight: 500; }
  .engineering-metrics dd { margin: 0; font-family: var(--font-mono); font-size: 3.25rem; font-weight: 400; line-height: 1.1; font-variant-numeric: tabular-nums; letter-spacing: 0; }
  .engineering-metrics dt > span { display: block; max-width: 24ch; margin-top: 0.375rem; font-size: 0.6875rem; font-weight: 400; line-height: 1.5; color: var(--engineering-muted); }
  .engineering-pipeline-wrap { padding: 1rem 1.25rem 1.25rem; border: 1px solid var(--engineering-rule); border-radius: 0.5rem; background: #ffffff03; }
  .engineering-pipeline-label { display: block; margin-bottom: 1rem; font-family: var(--font-mono); font-size: 0.625rem; color: var(--engineering-muted); }
  .engineering-pipeline { display: grid; gap: 1rem; padding: 0; margin: 0; list-style: none; }
  .engineering-pipeline li { display: flex; min-width: 0; align-items: center; gap: 0.75rem; font-family: var(--font-ui); font-size: 0.75rem; color: var(--engineering-text); }
  .pipeline-icon { display: grid; width: 2.25rem; height: 2.25rem; flex-shrink: 0; place-items: center; border: 1px solid var(--engineering-rule); border-radius: 0.375rem; background: #222823; color: var(--engineering-green); }
  .engineering-pipeline .pipeline-arrow { display: none; }
  .engineering-principles { display: grid; gap: 1.75rem; margin-block: 2rem; }
  .engineering-principles article { display: flex; align-items: flex-start; gap: 1rem; min-width: 0; }
  .engineering-principles article > :global(svg) { flex-shrink: 0; margin-top: 0.125rem; color: var(--engineering-muted); }
  .engineering-principles h3 { margin: 0; font-family: var(--font-ui); font-size: 0.9375rem; line-height: 1.4; font-weight: 500; letter-spacing: 0; color: var(--engineering-text); }
  .engineering-principles p { max-width: 36ch; margin: 0.625rem 0 0; font-size: 0.8125rem; line-height: 1.65; color: var(--engineering-muted); }
  .engineering-specs { display: flex; align-items: center; flex-wrap: wrap; gap: 0.5rem 2rem; padding-top: 1.25rem; border-top: 1px solid var(--engineering-rule); scroll-margin-top: calc(var(--header-h) + 1rem); }
  .engineering-specs > span { display: inline-flex; align-items: center; gap: 0.625rem; font-size: 0.75rem; color: var(--engineering-muted); }
  .engineering-specs nav { display: flex; flex-wrap: wrap; gap: 0.25rem 1.25rem; }
  .engineering-specs a { display: inline-flex; min-height: 2.75rem; align-items: center; gap: 0.5rem; font-family: var(--font-ui); font-size: 0.75rem; color: var(--engineering-text); }
  .engineering-specs a:hover { color: var(--engineering-accent); }
  .engineering-specs code { font-size: 0.625rem; color: var(--engineering-muted); }
  @media (min-width: 640px) {
    .contract-files { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.75rem; }
    .contract-file:nth-child(2) { margin-top: -0.75rem; margin-bottom: 0.75rem; }
    .engineering-metrics { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.5rem; }
    .engineering-metrics > div { align-items: flex-start; flex-direction: column; gap: 0.75rem; }
    .engineering-metrics > div + div { border-left: 1px solid var(--engineering-rule); padding-left: 1.5rem; }
    .engineering-pipeline { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .engineering-principles { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 900px) {
    .engineering-heading h2 { font-size: 2.75rem; }
    .engineering-metrics dd { font-size: 3.5rem; }
    .engineering-principles { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 2rem; margin-block: 2.5rem; }
    .engineering-pipeline { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 2rem; }
    .engineering-pipeline .pipeline-arrow { display: block; flex-shrink: 0; margin-left: auto; color: var(--engineering-rule); }
    .engineering-pipeline li:last-child .pipeline-arrow { display: none; }
    .engineering-specs nav { margin-left: auto; }
  }
  @media (min-width: 1200px) {
    .engineering-overview { grid-template-columns: minmax(0, 0.47fr) minmax(0, 0.53fr); gap: 3rem; }
    .engineering-heading h2 { font-size: 2.875rem; }
    .engineering-metrics > div { flex-direction: row; align-items: center; }
    .engineering-metrics dd { font-size: 3.75rem; }
  }
  @media (prefers-reduced-motion: reduce) { .contract-file:hover { transform: none; } }
</style>
