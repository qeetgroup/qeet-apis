---
import ArrowDownRight from "@lucide/astro/icons/arrow-down-right";
import ArrowUpLeft from "@lucide/astro/icons/arrow-up-left";
import BookOpen from "@lucide/astro/icons/book-open";
import Icon from "../shared/Icon.astro";

interface Action {
  href: string;
  label: string;
  icon?: Parameters<typeof Icon>[0]["name"];
  external?: boolean;
}
interface Props {
  title: string;
  highlight?: string;
  text: string;
  primary: Action;
  secondary?: Action;
}
const { title, highlight, text, primary, secondary } = Astro.props;
---

<section class="developer-cta" id="start-building" aria-labelledby="developer-cta-title">
  <div class="cta-corner cta-corner-primary" aria-hidden="true"></div>
  <div class="cta-corner cta-corner-secondary" aria-hidden="true"></div>
  <p class="cta-note cta-note-build" aria-hidden="true">
    Build.<br />Integrate.<br />Innovate.
    <ArrowDownRight size={42} stroke-width={1} />
  </p>

  <div class="cta-content">
    <p class="cta-eyebrow">Ready to build</p>
    <h2 class="cta-title" id="developer-cta-title">{title} {highlight && <span>{highlight}</span>}</h2>
    <p class="cta-description">{text}</p>
    <div class="cta-actions">
      <a
        class="cta-action cta-action-primary"
        href={primary.href}
        rel={primary.external ? "noopener noreferrer" : undefined}
        target={primary.external ? "_blank" : undefined}
      >
        {primary.label}
        <Icon name={primary.icon ?? "arrow-right"} class="h-5 w-5" />
      </a>
      {secondary && (
        <a
          class="cta-action cta-action-secondary"
          href={secondary.href}
          rel={secondary.external ? "noopener noreferrer" : undefined}
          target={secondary.external ? "_blank" : undefined}
        >
          {secondary.icon === "book" || !secondary.icon
            ? <BookOpen class="h-7 w-7" aria-hidden="true" />
            : <Icon name={secondary.icon} class="h-7 w-7" />}
          {secondary.label}
        </a>
      )}
    </div>
  </div>

  <div class="cta-mark-stack" aria-hidden="true">
    <div class="cta-mark-panel cta-mark-panel-back"></div>
    <div class="cta-mark-panel cta-mark-panel-far"></div>
    <div class="cta-mark-panel cta-mark-panel-front">
      <img src="/brand/logo-light.svg" alt="" width="60" height="60" class="block dark:hidden" />
      <img src="/brand/logo-dark.svg" alt="" width="60" height="60" class="hidden dark:block" />
    </div>
  </div>
  <p class="cta-note cta-note-apis" aria-hidden="true">
    <ArrowUpLeft size={38} stroke-width={1} />
    Real APIs.<br />One Qeet platform.
  </p>
</section>

<style>
  .developer-cta {
    --cta-rule: color-mix(in oklab, var(--ink) 6%, var(--surface));
    position: relative;
    isolation: isolate;
    overflow: clip;
    padding: 4rem 1.5rem;
    background: var(--bg);
    letter-spacing: 0;
  }
  .developer-cta::before {
    position: absolute;
    z-index: -1;
    inset: 0;
    content: "";
    background-image: linear-gradient(var(--cta-rule) 1px, transparent 1px), linear-gradient(90deg, var(--cta-rule) 1px, transparent 1px);
    background-size: 96px 96px;
    mask-image: linear-gradient(90deg, #0008, transparent 38%, transparent 64%, #0008);
    pointer-events: none;
  }
  .cta-content { position: relative; max-width: 70rem; margin-inline: auto; text-align: center; }
  .cta-eyebrow { margin: 0; font-family: var(--font-ui); font-size: 0.8125rem; font-weight: 600; line-height: 1.4; text-transform: uppercase; color: var(--brand-deep); }
  .cta-title { margin: 1.5rem 0 0; font-size: 2.25rem; font-weight: 600; line-height: 1.12; letter-spacing: 0; text-wrap: balance; }
  .cta-title > span { color: var(--brand); }
  .cta-description { max-width: 41rem; margin: 1.5rem auto 0; font-size: 1rem; line-height: 1.5; color: var(--ink-muted); text-wrap: pretty; }
  .cta-actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 1rem; margin-top: 1.75rem; }
  .cta-action { display: inline-flex; width: 100%; min-height: 3.5rem; align-items: center; justify-content: center; gap: 1.125rem; padding: 0.9375rem 1.5rem; border: 1px solid var(--rule); border-radius: 0.625rem; font-family: var(--font-ui); font-size: 0.9375rem; font-weight: 600; line-height: 1.4; text-align: center; transition: transform 0.3s var(--ease-heavy), box-shadow 0.3s var(--ease-heavy), border-color 0.3s var(--ease-heavy); }
  .cta-action-primary { border-color: var(--ink); background: var(--ink); color: var(--bg); box-shadow: inset 0 1px 0 color-mix(in oklab, var(--surface) 18%, transparent), var(--shadow-sm); }
  .cta-action-secondary { background: color-mix(in oklab, var(--surface) 65%, transparent); color: var(--ink); box-shadow: var(--shadow-sm); }
  .cta-action-primary:hover { color: var(--bg); }
  .cta-action-secondary:hover { border-color: var(--rule-strong); color: var(--ink); }
  .cta-action:hover { transform: translateY(-2px); box-shadow: var(--shadow-md); }
  .cta-action:active { transform: translateY(0); }
  .cta-action :global(svg) { flex-shrink: 0; }
  .cta-corner { position: absolute; z-index: -1; width: 24rem; height: 20rem; border: 1px solid color-mix(in oklab, var(--brand) 14%, transparent); border-radius: 2rem; background: linear-gradient(150deg, color-mix(in oklab, var(--brand) 20%, var(--bg)), color-mix(in oklab, var(--brand) 3%, var(--bg))); transform: rotate(35deg); pointer-events: none; }
  .cta-corner-primary { left: -9rem; bottom: -14rem; }
  .cta-corner-secondary { left: 12rem; bottom: -20rem; opacity: 0.45; }
  .cta-mark-stack { display: none; position: absolute; z-index: -1; top: 4rem; right: max(-2rem, calc((100% - 90rem) / 2)); width: 15rem; height: 18rem; pointer-events: none; }
  .cta-mark-panel { position: absolute; width: 8.75rem; height: 11.75rem; border: 1px solid color-mix(in oklab, var(--surface) 85%, var(--brand-soft)); border-radius: 0.75rem; transform: skewY(-30deg); background: color-mix(in oklab, var(--brand) 8%, var(--surface)); box-shadow: 0 20px 45px -32px var(--brand-soft); }
  .cta-mark-panel-back { left: -4.25rem; top: 0.625rem; height: 15.5rem; opacity: 0.55; }
  .cta-mark-panel-far { right: -2.75rem; top: 2rem; opacity: 0.75; background: color-mix(in oklab, var(--brand) 14%, var(--surface)); }
  .cta-mark-panel-front { display: grid; left: 1rem; top: 3rem; place-items: center; background: color-mix(in oklab, var(--surface) 87%, var(--brand)); box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--surface) 45%, transparent); }
  .cta-mark-panel-front img { width: 3.75rem; height: 3.75rem; }
  .cta-note { display: none; position: absolute; margin: 0; font-family: "Bradley Hand", "Segoe Print", "Comic Sans MS", cursive; font-size: 1.125rem; line-height: 1.2; color: var(--ink-subtle); pointer-events: none; }
  .cta-note-build { top: 8.25rem; left: max(3rem, calc((100% - 82rem) / 2)); transform: rotate(-8deg); }
  .cta-note-build :global(svg) { display: block; margin: 0.375rem 0 0 4rem; }
  .cta-note-apis { right: max(1.5rem, calc((100% - 86rem) / 2)); bottom: 3.375rem; transform: rotate(-10deg); font-size: 1rem; }
  .cta-note-apis :global(svg) { margin: 0 0 0.375rem 3.5rem; transform: rotate(22deg); }

  @media (min-width: 640px) {
    .cta-title { font-size: 3rem; }
    .cta-action { width: auto; min-width: 16.5rem; min-height: 4rem; font-size: 1rem; }
    .cta-action-primary { min-width: 17.5rem; }
  }
  @media (min-width: 1200px) {
    .developer-cta { padding-top: 5.875rem; padding-bottom: 3.625rem; }
    .cta-title { font-size: 3.5rem; }
    .cta-description { font-size: 1.125rem; }
    .cta-mark-stack, .cta-note { display: block; }
    .cta-corner-primary { bottom: -11rem; }
    .cta-corner-secondary { bottom: -17rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .cta-action { transition: none; }
    .cta-action:hover, .cta-action:active { transform: none; }
  }
</style>
