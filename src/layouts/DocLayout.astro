---
/**
 * Compatibility shim.
 *
 * The five MDX guides declare `layout: ../layouts/DocLayout.astro` in their
 * frontmatter. Rather than edit five files (and risk a route regression), this
 * forwards to DocsLayout and passes through the `headings` Astro injects for
 * MDX pages, which is what powers the table of contents.
 *
 * New pages should point at DocsLayout directly.
 */
import DocsLayout from "./DocsLayout.astro";

const { frontmatter, headings } = Astro.props;
---

<DocsLayout frontmatter={frontmatter} headings={headings}>
  <slot />
</DocsLayout>
